const siteUrl = "https://testbeforeyoubuild.com/";
const socialImage = `${siteUrl}og.jpg`;
const published = "2026-09-16";
const faqs = [
  { question: "What is business idea validation?", answer: "Business idea validation is a structured process for testing the assumptions that must be true for an idea to become a viable product, service or business. It examines the customer problem, target group, current alternatives, demand conditions, buying process and commercial model before major development investment." },
  { question: "How do you validate a business idea before building it?", answer: "Define the decision, identify the riskiest assumptions, select a realistic target group, gather existing market evidence, interview potential buyers or users, test the most important remaining assumptions and compare the evidence against decision criteria established in advance." },
  { question: "How many customer interviews are needed?", answer: "There is no universal number. The appropriate scope depends on participant relevance, the number of customer segments, the commercial question and how much new information each interview adds. A focused project may use 20 interviews, while broader studies may require substantially more." },
  { question: "Can customer interviews validate market demand?", answer: "Customer interviews can provide meaningful evidence about the strength, nature and conditions of demand. They reveal problems, current behaviour, alternatives, buying criteria and barriers to change. For some decisions, the next stage should add behavioural evidence such as a pilot, pre-sale, procurement step or purchase." },
  { question: "What is the difference between market research and business idea validation?", answer: "Market research describes a market, its size, competitors and trends. Business idea validation tests the specific assumptions behind a particular idea and connects the evidence to a decision about what to build, change or stop." },
  { question: "When should an idea be changed instead of killed?", answer: "Change the idea when the evidence supports a meaningful customer problem but weakens an important part of the proposed solution, target segment, positioning, buying process or commercial model. Kill or pause it when critical assumptions fail and no credible adjustment resolves them." },
];
