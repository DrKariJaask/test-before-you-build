---
const title = "Thank You | Test Before You Build";
const description = "Your idea has been sent to Test Before You Build.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">Message received</p>
      <h1>Thank you for sharing your idea.</h1>
      <p class="lead">
        Your message has been sent. Kari will review it personally and get back
        to you about whether customer validation could help with your decision.
      </p>
      <div class="actions"><a class="button" href="/">Return to the homepage</a><a href="/about-kari-jaaskelainen/">About Kari</a></div>
    </main>
  </body>
</html>

<style>
  :root {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    color: #0d1930;
    background: #f5f8fc;
    line-height: 1.65;
  }
  * { box-sizing: border-box; }
  body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 32px 20px; }
  main { width: min(700px, 100%); padding: clamp(32px, 7vw, 64px); border: 1px solid #d8e0ec; border-radius: 24px; background: #fff; box-shadow: 0 24px 70px rgba(13, 25, 48, .09); }
  .eyebrow { margin: 0 0 12px; color: #155eef; font-size: 1rem; line-height: 1.3; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 0 0 20px; font-size: clamp(2.3rem, 7vw, 4.2rem); line-height: 1.08; letter-spacing: -.025em; }
  .lead { margin: 0 0 32px; color: #536781; font-size: 1.15rem; }
  .button { display: inline-flex; padding: 13px 20px; border-radius: 10px; background: #155eef; color: #fff; font-weight: 800; text-decoration: none; }
  .button:hover { background: #0f4dcc; }
  .actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; }
  .actions > a:not(.button) { color: #155eef; font-weight: 800; }
</style>
