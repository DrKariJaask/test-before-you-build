---
const title = "Test Before You Build";
const description =
  "We find 20 potential customers, interview them, and give you the evidence to decide whether to build, change, or kill your idea.";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1f3a" />
    <title>{title}</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/">
          <span class="brand-mark"></span>
          <span>Test Before You Build</span>
        </a>

        <nav class="main-nav" aria-label="Primary navigation">
          <a href="#how-it-works">How It Works</a>
          <a href="#why">Why It Works</a>
          <a href="#pricing">Pricing</a>
          <a href="#faq">FAQ</a>
        </nav>

        <a class="button button-small" href="#contact">Test My Idea</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              Real customer evidence before you invest
            </p>

            <h1>
              Find out if customers actually want your idea
              <span>before you build it.</span>
            </h1>

            <p class="hero-lead">
              We find 20 potential customers, interview them, analyze what they
              tell us, and give you a clear recommendation:
              <strong>&nbsp;BUILD, CHANGE, OR KILL.</strong>
            </p>

            <div class="hero-actions">
              <a class="button" href="#contact">
                Test My Idea
              </a>

              <a class="text-link" href="#how-it-works">
                See how it works
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="hero-note">
              <span class="dot"></span>
              Built for B2B and B2C products, services, software, and research-based
              innovations.
            </div>
          </div>

          <div
            class="decision-panel"
            aria-label="Validation process summary"
          >
            <div class="panel-top">
              <span>Validation sprint</span>
              <span class="status">20 interviews</span>
            </div>

            <div class="flow">
              <div class="flow-step">
                <span class="number">20</span>
                <span class="label">Potential customers</span>
              </div>

              <div class="flow-line"></div>

              <div class="flow-step">
                <span class="number">Real</span>
                <span class="label">Customer conversations</span>
              </div>

              <div class="flow-line"></div>

              <div class="flow-step">
                <span class="number">Clear</span>
                <span class="label">Commercial recommendation</span>
              </div>
            </div>

            <div class="decision-box">
              <p>Recommendation</p>
              <strong>BUILD · CHANGE · KILL</strong>
            </div>
          </div>
        </div>
      </section>

      <section id="why" class="section section-dark">
        <div class="container split-layout">
          <div>
            <p class="eyebrow eyebrow-light">
              Why this is different
            </p>

            <h2>
              AI tries to analyze your idea. We ask real customers.
            </h2>
          </div>

          <div class="body-copy body-copy-light">
            <p>
              AI can estimate market size, analyze competitors, and challenge
              your business model.
            </p>

            <p>
              But it cannot replace direct conversations with the people who
              might actually buy your product.
            </p>

            <p>
              We speak with those people and turn their answers into evidence
              you can use before spending months building the wrong thing.
            </p>
          </div>
        </div>
      </section>

      <section id="how-it-works" class="section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">
              How it works
            </p>

            <h2>
              From idea to evidence in five steps.
            </h2>
          </div>

          <div class="steps">
            <article class="step">
              <span class="step-number">01</span>
              <h3>You tell us your idea</h3>
              <p>
                You explain the product, target customer, and the assumptions
                you want to test.
              </p>
            </article>

            <article class="step">
              <span class="step-number">02</span>
              <h3>We find the right people</h3>
              <p>
                We identify 20 realistic potential customers in your target
                market.
              </p>
            </article>

            <article class="step">
              <span class="step-number">03</span>
              <h3>We interview them</h3>
              <p>
                We speak with them directly about the problem, current
                alternatives, buying behavior, and willingness to pay.
              </p>
            </article>

            <article class="step">
              <span class="step-number">04</span>
              <h3>We analyze the evidence</h3>
              <p>
                We identify repeated patterns, objections, demand signals, and
                the most important changes to make.
              </p>
            </article>

            <article class="step">
              <span class="step-number">05</span>
              <h3>You make the decision</h3>
              <p>
                You receive a clear recommendation: build, change, or kill the
                idea.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section section-soft">
        <div class="container insight-layout">
          <div class="insight-card">
            <p class="eyebrow">
              What we are really testing
            </p>

            <h2>
              Not whether people like the idea.
            </h2>

            <p class="insight-lead">
              We want to know whether the problem is important enough for a
              real buyer to act.
            </p>
          </div>

          <div class="signal-list">
            <div class="signal">
              <span>01</span>
              <div>
                <strong>Problem severity</strong>
                <p>Is the problem painful enough to matter now?</p>
              </div>
            </div>

            <div class="signal">
              <span>02</span>
              <div>
                <strong>Current behavior</strong>
                <p>How are customers solving the problem today?</p>
              </div>
            </div>

            <div class="signal">
              <span>03</span>
              <div>
                <strong>Willingness to change</strong>
                <p>Would they seriously consider a better alternative?</p>
              </div>
            </div>

            <div class="signal">
              <span>04</span>
              <div>
                <strong>Willingness to pay</strong>
                <p>Does the idea have credible commercial value?</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="pricing" class="section">
        <div class="container pricing-layout">
          <div class="pricing-copy">
            <p class="eyebrow">
              Idea Validation Sprint
            </p>

            <h2>
              Know before you build.
            </h2>

            <p>
              A focused project designed to answer one important commercial
              question:
            </p>

            <blockquote>
              Is there enough real customer demand to justify building this?
            </blockquote>
          </div>

          <div class="price-card">
            <div class="price-top">
              <div>
                <span class="price-label">
                  Fixed project price
                </span>

                <p class="price">
                  €2,900
                </p>
              </div>

              <span class="price-tag">
                20 interviews
              </span>
            </div>

            <ul>
              <li>Target customer definition</li>
              <li>20 interviews with potential customers </li>
              <li>Problem and demand validation</li>
              <li>Buying objections and customer language</li>
              <li>Willingness-to-pay signals</li>
              <li>Key findings and recommended changes</li>
              <li>BUILD / CHANGE / KILL conclusion</li>
            </ul>

            <a class="button button-full" href="#contact">
              Test My Idea
            </a>
          </div>
        </div>
      </section>

      <section id="faq" class="section section-soft">
        <div class="container faq-layout">
          <div>
            <p class="eyebrow">
              FAQ
            </p>

            <h2>
              Questions you may have.
            </h2>
          </div>

          <div class="faq-list">
            <details>
              <summary>What kinds of ideas can you test?</summary>
              <p>
                We focus mainly on B2B or B2C products, services, software, and
                research-based innovations where realistic potential customers
                can be clearly identified.
              </p>
            </details>

            <details>
              <summary>Why 20 interviews?</summary>
              <p>
                Twenty conversations are usually enough to reveal repeated
                patterns while keeping the project fast enough to influence an
                early product decision.
              </p>
            </details>

            <details>
              <summary>Do you only interview people who already know us?</summary>
              <p>
                No. The goal is to speak with realistic potential customers,
                not only people already connected to your organization.
              </p>
            </details>

            <details>
              <summary>What do we receive?</summary>
              <p>
                You receive a report containing the main findings, demand signals, objections,
                recommended changes, and a clear build, change, or kill
                recommendation.
              </p>
            </details>
          </div>
        </div>
      </section>

      <section id="contact" class="section contact-section">
        <div class="container contact-card">
          <div>
            <p class="eyebrow eyebrow-light">
              Before you spend months building
            </p>

            <h2>
              Let us ask the customers first.
            </h2>

            <p>
              Tell us what you are thinking of building. We will help you find
              out whether the market agrees.
            </p>
          </div>

          <div>
            <a
              class="button button-light"
              href="mailto:kari@testbeforeyoubuild.com"
            >
              Test My Idea
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-wrap">
        <span>© 2026 Test Before You Build</span>
        <span>Evidence before investment.</span>
      </div>
    </footer>

    <style>
      :root {
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        color: #0d1930;
        background: #ffffff;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at top right,
            rgba(44, 104, 255, 0.08),
            transparent 32%
          ),
          #ffffff;
        color: #0d1930;
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(1160px, calc(100% - 40px));
        margin: 0 auto;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 20;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(18px);
        border-bottom: 1px solid rgba(13, 25, 48, 0.08);
      }

      .nav-wrap {
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        letter-spacing: -0.025em;
      }

      .brand-mark {
        width: 15px;
        height: 15px;
        border-radius: 4px;
        background: linear-gradient(135deg, #155eef, #67a2ff);
        box-shadow: 0 4px 16px rgba(21, 94, 239, 0.25);
      }

      .main-nav {
        display: flex;
        gap: 28px;
        font-size: 0.94rem;
        color: #40506b;
      }

      .main-nav a:hover {
        color: #155eef;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 0 22px;
        border-radius: 12px;
        background: #155eef;
        color: #ffffff;
        font-weight: 800;
        box-shadow: 0 10px 30px rgba(21, 94, 239, 0.18);
        transition:
          transform 160ms ease,
          box-shadow 160ms ease,
          background 160ms ease;
      }

      .button:hover {
        transform: translateY(-1px);
        background: #0d4ed7;
        box-shadow: 0 14px 34px rgba(21, 94, 239, 0.24);
      }

      .button-small {
        min-height: 42px;
        padding: 0 16px;
        font-size: 0.9rem;
      }

      .hero {
        min-height: calc(100vh - 72px);
        display: flex;
        align-items: center;
        padding: 48px 0;
      }

      .hero-grid {
        display: grid;
        grid-template-columns:
          minmax(0, 1.12fr)
          minmax(340px, 0.88fr);
        gap: 54px;
        align-items: center;
      }

      .hero-copy {
        min-width: 0;
      }

      .eyebrow {
        margin: 0 0 12px;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.74rem;
        font-weight: 900;
        color: #155eef;
      }

      .eyebrow-light {
        color: #8bb4ff;
      }

      h1,
      h2,
      h3 {
        margin-top: 0;
        line-height: 1.03;
        letter-spacing: -0.045em;
      }

      h1 {
        max-width: 760px;
        margin-bottom: 20px;
        font-size: clamp(3rem, 5.2vw, 5.25rem);
      }

      h1 span {
        display: block;
        color: #6480aa;
      }

      h2 {
        margin-bottom: 22px;
        font-size: clamp(2.3rem, 4.7vw, 4.5rem);
      }

      h3 {
        margin-bottom: 12px;
        font-size: 1.35rem;
      }

      .hero-lead {
        max-width: 700px;
        margin: 0;
        font-size: 1.15rem;
        line-height: 1.55;
        color: #4f607c;
      }

      .hero-lead strong {
        color: #0d1930;
      }

      .hero-actions {
        margin-top: 24px;
        display: flex;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
      }

      .text-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 800;
        color: #244063;
      }

      .hero-note {
        margin-top: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        max-width: 670px;
        color: #6e7f98;
        font-size: 0.88rem;
      }

      .dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: #2f75ff;
        box-shadow: 0 0 0 5px rgba(47, 117, 255, 0.12);
        flex: 0 0 auto;
      }

      .decision-panel {
        border: 1px solid rgba(16, 52, 97, 0.12);
        border-radius: 24px;
        padding: 22px;
        background:
          linear-gradient(
            180deg,
            rgba(255, 255, 255, 0.97),
            rgba(246, 249, 255, 0.98)
          );
        box-shadow: 0 30px 80px rgba(38, 65, 106, 0.14);
      }

      .panel-top {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        color: #6c7b91;
        font-size: 0.82rem;
      }

      .status {
        padding: 4px 9px;
        border-radius: 999px;
        background: #eaf1ff;
        color: #155eef;
        font-weight: 800;
      }

      .flow {
        margin: 24px 0;
      }

      .flow-step {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 20px;
      }

      .number {
        font-size: 1.8rem;
        font-weight: 900;
        letter-spacing: -0.04em;
      }

      .label {
        color: #6c7b91;
        text-align: right;
        font-size: 0.94rem;
      }

      .flow-line {
        height: 28px;
        width: 1px;
        margin: 6px 0 6px 13px;
        background: linear-gradient(#9ab9f0, #dfe9fa);
      }

      .decision-box {
        padding: 18px;
        border-radius: 16px;
        background: #0b1f3a;
        color: #ffffff;
      }

      .decision-box p {
        margin: 0 0 4px;
        color: #9fb4d1;
        font-size: 0.8rem;
      }

      .decision-box strong {
        font-size: 1rem;
        letter-spacing: 0.04em;
      }

      .section {
        padding: 100px 0;
      }

      .section-dark {
        background:
          radial-gradient(
            circle at 80% 15%,
            rgba(34, 100, 255, 0.24),
            transparent 28%
          ),
          #0b1f3a;
        color: #ffffff;
      }

      .section-soft {
        background: #f5f8fc;
      }

      .split-layout {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 90px;
        align-items: start;
      }

      .body-copy {
        font-size: 1.16rem;
      }

      .body-copy p {
        margin-top: 0;
        margin-bottom: 24px;
      }

      .body-copy-light {
        color: #cad7e8;
      }

      .section-heading {
        max-width: 780px;
        margin-bottom: 50px;
      }

      .steps {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 18px;
      }

      .step {
        min-height: 275px;
        padding: 24px;
        border: 1px solid rgba(13, 25, 48, 0.1);
        border-radius: 18px;
        background: #ffffff;
      }

      .step-number {
        display: inline-block;
        margin-bottom: 54px;
        font-size: 0.8rem;
        font-weight: 900;
        letter-spacing: 0.08em;
        color: #155eef;
      }

      .step p {
        margin-bottom: 0;
        color: #697a94;
      }

      .insight-layout {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: 70px;
        align-items: start;
      }

      .insight-card {
        position: sticky;
        top: 110px;
      }

      .insight-lead {
        max-width: 520px;
        font-size: 1.15rem;
        color: #667994;
      }

      .signal-list {
        border-top: 1px solid #d9e1ec;
      }

      .signal {
        display: grid;
        grid-template-columns: 70px 1fr;
        gap: 20px;
        padding: 28px 0;
        border-bottom: 1px solid #d9e1ec;
      }

      .signal > span {
        color: #155eef;
        font-weight: 900;
      }

      .signal strong {
        font-size: 1.08rem;
      }

      .signal p {
        margin: 5px 0 0;
        color: #6b7d97;
      }

      .pricing-layout {
        display: grid;
        grid-template-columns: 1fr 0.9fr;
        gap: 90px;
        align-items: start;
      }

      .pricing-copy > p:not(.eyebrow) {
        max-width: 570px;
        font-size: 1.15rem;
        color: #65768f;
      }

      blockquote {
        margin: 28px 0 0;
        padding-left: 20px;
        border-left: 3px solid #155eef;
        font-size: 1.2rem;
        font-weight: 800;
        color: #213c5f;
      }

      .price-card {
        padding: 32px;
        border: 1px solid rgba(13, 25, 48, 0.1);
        border-radius: 24px;
        background: #ffffff;
        box-shadow: 0 24px 70px rgba(46, 72, 107, 0.1);
      }

      .price-top {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        align-items: flex-start;
      }

      .price-label {
        display: block;
        margin-bottom: 6px;
        color: #6d7d93;
        font-size: 0.86rem;
      }

      .price {
        margin: 0;
        font-size: 3.4rem;
        font-weight: 900;
        line-height: 1;
        letter-spacing: -0.055em;
      }

      .price-tag {
        padding: 7px 11px;
        border-radius: 999px;
        background: #eaf1ff;
        color: #155eef;
        font-size: 0.78rem;
        font-weight: 900;
      }

      .price-card ul {
        margin: 30px 0;
        padding-left: 20px;
      }

      .price-card li {
        margin-bottom: 9px;
        color: #536781;
      }

      .button-full {
        width: 100%;
      }

      .faq-layout {
        display: grid;
        grid-template-columns: 0.75fr 1.25fr;
        gap: 80px;
      }

      .faq-list {
        border-top: 1px solid #d8e0ec;
      }

      details {
        padding: 22px 0;
        border-bottom: 1px solid #d8e0ec;
      }

      summary {
        cursor: pointer;
        list-style: none;
        font-size: 1.05rem;
        font-weight: 850;
      }

      summary::-webkit-details-marker {
        display: none;
      }

      details p {
        margin-bottom: 0;
        color: #687a95;
      }

      .contact-section {
        background: #ffffff;
      }

      .contact-card {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 50px;
        align-items: center;
        padding: 56px;
        border-radius: 28px;
        background:
          radial-gradient(
            circle at 90% 0%,
            rgba(67, 130, 255, 0.32),
            transparent 35%
          ),
          #0b1f3a;
        color: #ffffff;
      }

      .contact-card h2 {
        margin-bottom: 14px;
      }

      .contact-card p:not(.eyebrow) {
        max-width: 670px;
        margin-bottom: 0;
        color: #c2d0e2;
        font-size: 1.08rem;
      }

      .button-light {
        background: #ffffff;
        color: #0b1f3a;
        box-shadow: none;
      }

      .button-light:hover {
        background: #eef4ff;
      }

      .site-footer {
        padding: 30px 0;
        border-top: 1px solid rgba(13, 25, 48, 0.08);
      }

      .footer-wrap {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        color: #728199;
        font-size: 0.9rem;
      }

      @media (max-width: 980px) {
        .main-nav {
          display: none;
        }

        .hero {
          min-height: auto;
          padding: 70px 0;
        }

        .hero-grid,
        .split-layout,
        .insight-layout,
        .pricing-layout,
        .faq-layout,
        .contact-card {
          grid-template-columns: 1fr;
        }

        .steps {
          grid-template-columns: 1fr 1fr;
        }

        .insight-card {
          position: static;
        }

        .contact-card {
          padding: 38px;
        }
      }

      @media (max-width: 640px) {
        .container {
          width: min(calc(100% - 28px), 1160px);
        }

        .button-small {
          display: none;
        }

        .hero {
          padding: 54px 0 64px;
        }

        .hero-grid {
          gap: 40px;
        }

        h1 {
          font-size: clamp(2.7rem, 13vw, 4rem);
        }

        .hero-lead {
          font-size: 1.08rem;
        }

        .steps {
          grid-template-columns: 1fr;
        }

        .section {
          padding: 72px 0;
        }

        .step {
          min-height: auto;
        }

        .step-number {
          margin-bottom: 30px;
        }

        .price-top {
          flex-direction: column;
        }

        .contact-card {
          padding: 30px 24px;
        }

        .footer-wrap {
          flex-direction: column;
        }
      }
    </style>
  </body>
</html>