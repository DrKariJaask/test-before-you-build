---
const title = "Page Not Found | Test Before You Build";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">404 · Page not found</p>
      <h1>This page does not exist.</h1>
      <p>The address may be incorrect or the page may have moved.</p>
      <a href="/">Return to Test Before You Build</a>
    </main>
  </body>
</html>

<style>
  :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #fff; background: #0b1f3a; }
  * { box-sizing: border-box; }
  body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 24px; }
  main { width: min(700px, 100%); }
  .eyebrow { color: #8bb4ff; font-size: 1rem; line-height: 1.3; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  h1 { margin: 14px 0; font-size: clamp(3rem, 9vw, 6rem); line-height: 1.05; letter-spacing: -.03em; }
  p { color: #cad7e8; font-size: 1.15rem; }
  a { display: inline-flex; margin-top: 20px; min-height: 48px; align-items: center; padding: 0 22px; border-radius: 12px; background: #fff; color: #0b1f3a; font-weight: 800; text-decoration: none; }
</style>
