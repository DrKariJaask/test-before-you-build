const title = "Customer Discovery Interviews: Questions, Process and Evidence";
const description = "Learn how to run customer discovery interviews, ask useful questions, avoid biased answers and turn interview evidence into a commercial decision.";
const canonical = "https://testbeforeyoubuild.com/customer-discovery-interviews/";
const siteUrl = "https://testbeforeyoubuild.com/";
const socialImage = `${siteUrl}og.jpg`;
const published = "2026-09-17";
const faqs = [
  { question: "What is a customer discovery interview?", answer: "A customer discovery interview is a structured but flexible conversation used to understand a participant’s actual problems, behaviour, alternatives, constraints and decision process. Its purpose is to learn how the market works before committing to a solution—not to pitch an idea or collect compliments." },
  { question: "What questions should you ask in a customer discovery interview?", answer: "Ask about a recent real situation: what happened, what triggered action, what the person did, which alternatives they considered, what the consequences were and who influenced the decision. Follow answers with neutral probes such as ‘What happened next?’ and ‘Can you give me an example?’" },
  { question: "Should you show the product during a discovery interview?", answer: "Understand the participant’s current situation before showing a concept. If solution feedback is part of the research, separate it clearly from problem discovery and record which findings arose before and after the concept was introduced." },
  { question: "How long should a customer discovery interview take?", answer: "There is no universal duration. A focused conversation often fits within 30–45 minutes, while a complex buying process may require longer. The guide should be short enough to allow follow-up questions and detailed examples rather than rushing through a questionnaire." },
  { question: "How do you avoid leading customer interview questions?", answer: "Use neutral, open wording; ask about past events before future intentions; avoid revealing the answer you hope to hear; ask one question at a time; and probe both positive and negative evidence. Pilot the guide and review transcripts for questions that repeatedly invite agreement." },
  { question: "How should customer discovery interviews be analysed?", answer: "Analyse interviews systematically across participants. Separate observation from interpretation, code evidence by decision-relevant themes, compare roles and segments, retain contradictions and link conclusions to supporting transcript passages. Do not reduce the analysis to a count of positive comments." },
];
