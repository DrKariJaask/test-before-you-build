---
const title = "Market Validation Services and Pricing | €2,900 + VAT";
const description =
  "Independent market validation through 20 customer interviews, transcripts, evidence analysis and a BUILD, CHANGE or KILL recommendation. Fixed price: €2,900 + VAT.";
const canonical =
  "https://testbeforeyoubuild.com/market-validation-services-pricing/";
const siteUrl = "https://testbeforeyoubuild.com/";
const socialImage = `${siteUrl}og.jpg`;

const faqs = [
  {
    question: "Who can validate a business, product or research-based idea?",
    answer:
      "An experienced independent customer-discovery professional can validate it by interviewing realistic potential buyers or users and analysing their problems, behaviour and decision criteria.",
  },
  {
    question: "Who selects the interviewees?",
    answer:
      "Dr. Kari identifies approximately 30–40 suitable prospects based on the agreed target definition. The client approves the target list before outreach begins.",
  },
  {
    question: "Who recruits and interviews the participants?",
    answer:
      "Dr. Kari handles the outreach and conducts the 20 interviews.",
  },
  {
    question: "Will the interview participants be buyers or users?",
    answer:
      "Depending on the project, the target group may consist of potential buyers, users or both. The target definition and prospect list are agreed with the client before recruitment begins.",
  },
  {
    question: "Is the service limited to 20 interviews?",
    answer:
      "No. The standard €2,900 plus VAT service includes 20 interviews. Projects involving multiple customer segments, buyer roles, countries, use cases or broader objectives can be scoped and priced separately.",
  },
  {
    question: "Why use an independent interviewer?",
    answer:
      "An independent interviewer can ask neutral questions, investigate objections without defending the idea and reduce the influence of internal assumptions on the findings.",
  },
  {
    question: "What does the client receive?",
    answer:
      "The client receives the transcripts, evidence analysis, written report, recommended changes and BUILD, CHANGE or KILL recommendation.",
  },
  {
    question: "Can you validate specialised B2B or research-based ideas?",
    answer:
      "Yes, provided a realistic target group can be defined and reached. The specialisation and accessibility of that group may affect the schedule.",
  },
  {
    question: "How is interview material handled?",
    answer:
      "Recording, transcription, client access, confidentiality, retention and deletion arrangements are confirmed as part of the project. Participants are informed about the handling of their interview material.",
  },
  {
    question: "Does the service guarantee that the idea will succeed?",
    answer:
      "The service evaluates the strength, nature and conditions of demand and reduces uncertainty before development. No research method can guarantee future sales, adoption, funding or commercial success.",
  },
  {
    question: "How much does the service cost?",
    answer: "The fixed project price is €2,900 + VAT.",
  },
  {
    question: "How long does the project take?",
    answer:
      "A typical project takes approximately 2–4 weeks. The schedule depends primarily on the accessibility and specialisation of the target customer group and is confirmed before the project begins.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { "@id": `${siteUrl}#website` },
      about: { "@id": `${canonical}#service` },
      breadcrumb: { "@id": `${canonical}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Test Before You Build",
          item: siteUrl,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Market Validation Services and Pricing",
          item: canonical,
        },
      ],
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Test Before You Build",
      url: siteUrl,
      founder: { "@id": `${siteUrl}#kari-jaaskelainen` },
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}#kari-jaaskelainen`,
      name: "Dr. Kari Jääskeläinen",
      url: `${siteUrl}about-kari-jaaskelainen/`,
      image: `${siteUrl}kari-jaaskelainen.jpg`,
      worksFor: { "@id": `${siteUrl}#organization` },
      jobTitle: "Customer validation consultant",
    },
    {
      "@type": "Service",
      "@id": `${canonical}#service`,
      name: "Market Validation Service",
      url: canonical,
      description,
      provider: { "@id": `${siteUrl}#organization` },
      serviceType: "Independent market validation and customer discovery",
      offers: {
        "@type": "Offer",
        price: "2900",
        priceCurrency: "EUR",
        url: `${canonical}#pricing`,
        availability: "https://schema.org/InStock",
      },
    },
    {
      "@type": "FAQPage",
      "@id": `${canonical}#faq-schema`,
      mainEntity: faqs.map(({ question, answer }) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0b1f3a" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="text/markdown"
      href={`${siteUrl}market-validation-services-pricing.md`}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Test Before You Build" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/">
          <span class="brand-mark"></span>
          <span>Test Before You Build</span>
        </a>
        <nav class="main-nav" aria-label="Primary navigation">
          <a href="#how-it-works">How it works</a>
          <a href="#deliverables">What you receive</a>
          <a href="#pricing">Pricing</a>
          <a href="/about-kari-jaaskelainen/">About Dr. Kari</a>
          <a href="#faq">FAQ</a>
        </nav>
        <a class="button button-small" href="#contact">Submit your idea</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Market validation services and pricing</p>
            <h1>
              Know whether your idea is worth building
              <span>— before you build it.</span>
            </h1>
            <p class="hero-lead">
              Independent market validation through 20 customer interviews,
              evidence analysis and a clear <strong>BUILD, CHANGE or KILL</strong>
              recommendation. Fixed price: <strong>€2,900 + VAT.</strong>
            </p>
            <div class="hero-actions">
              <a class="button" href="#contact">Submit your idea</a>
              <a class="text-link" href="#included">See what is included <span aria-hidden="true">→</span></a>
            </div>
          </div>

          <aside class="project-card" aria-label="Project summary">
            <div class="project-card-top">
              <span>Independent validation project</span>
              <strong>€2,900 + VAT</strong>
            </div>
            <dl>
              <div><dt>Research</dt><dd>20 interviews</dd></div>
              <div><dt>Prospect list</dt><dd>30–40 for your approval</dd></div>
              <div><dt>Evidence</dt><dd>Transcripts and analysis</dd></div>
              <div><dt>Decision</dt><dd>BUILD · CHANGE · KILL</dd></div>
              <div><dt>Typical timeline</dt><dd>Approximately 2–4 weeks</dd></div>
            </dl>
          </aside>
        </div>
      </section>

      <section class="section section-compact">
        <div class="container split-layout">
          <div>
            <p class="eyebrow">The decision</p>
            <h2>Do customers experience a problem worth solving?</h2>
          </div>
          <div class="body-copy">
            <p>
              Internal enthusiasm, desk research and AI analysis can help shape
              an idea. They cannot replace direct conversations with realistic
              potential buyers or users.
            </p>
            <p>
              Test Before You Build investigates how the target group experiences
              the problem, what they do about it today, what could prevent adoption
              and whether the proposed value is commercially meaningful.
            </p>
            <p>
              The evidence helps you decide whether to proceed, change direction
              or stop before committing more resources.
            </p>
          </div>
        </div>
      </section>

      <section class="section section-soft">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Who it is for</p>
            <h2>Independent evidence for a meaningful investment decision.</h2>
          </div>
          <div class="fit-grid">
            <article class="fit-card fit-card-positive">
              <h3>A strong fit for</h3>
              <ul>
                <li>B2B and B2C founders validating an early-stage product or service.</li>
                <li>Corporate innovation teams assessing a new product concept.</li>
                <li>Researchers and technology-transfer teams exploring commercial demand.</li>
                <li>EU-funded projects seeking external customer evidence.</li>
                <li>Accelerators and investors seeking an independent view.</li>
                <li>Teams developing software or research-based innovations.</li>
              </ul>
            </article>
            <article class="fit-card">
              <h3>Not the right fit when</h3>
              <ul>
                <li>You need statistically representative quantitative research.</li>
                <li>No realistic group of potential buyers or users can be defined.</li>
                <li>You only want positive feedback for a decision already made.</li>
                <li>You are unwilling to change or stop the idea if the evidence is weak.</li>
              </ul>
            </article>
          </div>
          <div class="center-action"><a class="button" href="#contact">Submit your idea</a></div>
        </div>
      </section>

      <section id="included" class="section">
        <div class="container included-layout">
          <div class="section-heading sticky-heading">
            <p class="eyebrow">Market validation services and pricing</p>
            <h2>What the €2,900 + VAT service includes</h2>
            <p>
              The fixed-price project covers the customer-discovery work needed
              to turn an idea into a more informed commercial decision.
            </p>
          </div>
          <div class="included-list">
            <div><span>01</span><p>Clarification of the idea and the decision it must support.</p></div>
            <div><span>02</span><p>Definition of the relevant potential-buyer or user group.</p></div>
            <div><span>03</span><p>Identification of approximately 30–40 suitable prospects.</p></div>
            <div><span>04</span><p>Client review and approval of the target list before outreach.</p></div>
            <div><span>05</span><p>Recruitment of 20 interview participants.</p></div>
            <div><span>06</span><p>Preparation and completion of 20 interviews.</p></div>
            <div><span>07</span><p>Interview transcripts.</p></div>
            <div><span>08</span><p>Analysis of problems, current behaviour and demand signals.</p></div>
            <div><span>09</span><p>Buying objections and willingness-to-change and willingness-to-pay signals.</p></div>
            <div><span>10</span><p>A written report, recommended changes and a BUILD, CHANGE or KILL recommendation.</p></div>
          </div>
        </div>
        <div class="container scope-note">
          The participants may be realistic potential buyers, users or both,
          depending on the agreed target definition. The service does not imply
          that every participant is a confirmed buyer.
        </div>
      </section>

      <section id="how-it-works" class="section section-dark">
        <div class="container">
          <div class="section-heading section-heading-light">
            <p class="eyebrow eyebrow-light">The 20-interview process</p>
            <h2>From commercial question to decision in six steps.</h2>
          </div>
          <div class="process-grid">
            <article><span>01</span><h3>Define the decision and target group</h3><p>You explain what you are planning to build, who it is for and which assumptions create the greatest commercial risk.</p></article>
            <article><span>02</span><h3>Identify and approve the prospects</h3><p>Dr. Kari identifies approximately 30–40 suitable prospects based on the agreed target definition. The client approves the target list before outreach begins.</p></article>
            <article><span>03</span><h3>Recruit 20 participants</h3><p>Dr. Kari handles the outreach and recruits 20 suitable participants.</p></article>
            <article><span>04</span><h3>Conduct and document the interviews</h3><p>Dr. Kari conducts 20 independent interviews examining problems, current alternatives, decision criteria and barriers to change. The interviews are transcribed.</p></article>
            <article><span>05</span><h3>Analyse the evidence</h3><p>Responses are compared to identify repeated themes, meaningful disagreements, objections and demand signals.</p></article>
            <article><span>06</span><h3>Deliver the recommendation</h3><p>You receive the transcripts, analysis, report, recommended changes and BUILD, CHANGE or KILL recommendation.</p></article>
          </div>
          <p class="scope-note">
            <strong>How many interviews are enough?</strong> The standard service
            includes 20 interviews, while projects covering several segments,
            roles or markets can be scoped separately.
            <a class="text-link" href="/how-many-customer-interviews/">Read the evidence-based guide →</a>
          </p>
          <p class="scope-note">
            <strong>Planning to validate the idea yourself?</strong>
            <a class="text-link" href="/how-to-validate-a-business-idea/">Read the complete business idea validation process →</a>
          </p>
        </div>
      </section>

      <section class="section">
        <div class="container split-layout">
          <div>
            <p class="eyebrow">Why independence matters</p>
            <h2>Hear the evidence without having to defend the idea.</h2>
          </div>
          <div class="body-copy">
            <p>
              Teams are naturally close to their ideas. This can affect which
              questions are asked, how participants respond and how ambiguous
              answers are interpreted.
            </p>
            <ul class="check-list">
              <li>Consistent, non-leading questions.</li>
              <li>Less pressure on participants to please the idea’s creator.</li>
              <li>Customer evidence separated from internal advocacy.</li>
              <li>Objections investigated without defending the concept.</li>
              <li>An external evidence base for decision-makers.</li>
            </ul>
            <p>
              Your team still provides the technical and market context.
              Independence protects the neutrality of the interviews and analysis.
            </p>
          </div>
        </div>
      </section>

      <section id="deliverables" class="section section-soft">
        <div class="container deliverables-layout">
          <div class="deliverables-card">
            <p class="eyebrow">What you receive</p>
            <h2>A decision-ready evidence package.</h2>
            <p>
              You receive the 20 interview transcripts, analysis
              of recurring findings and important differences, a written report,
              recommended changes and the final recommendation.
            </p>
            <p>
              The report explains relevant evidence limitations. The deliverables
              support a better-informed decision; they do not promise future sales,
              adoption, funding or commercial success.
            </p>
          </div>
          <div class="decision-grid">
            <article class="decision build"><strong>BUILD</strong><p>The evidence supports continued investment, subject to the risks and assumptions identified.</p></article>
            <article class="decision change"><strong>CHANGE</strong><p>The opportunity may be meaningful, but the customer, problem, value proposition, positioning or solution should be revised.</p></article>
            <article class="decision kill"><strong>KILL</strong><p>The evidence does not currently justify further investment in the idea or direction tested.</p></article>
          </div>
        </div>
        <div class="container decision-note">
          The recommendation supports the client’s decision. It does not replace
          the client’s commercial, technical or investment judgement.
        </div>
      </section>

      <section id="pricing" class="section">
        <div class="container pricing-layout">
          <div class="pricing-copy">
            <p class="eyebrow">Price and schedule</p>
            <h2>One complete validation project.</h2>
            <p>
              A typical project takes approximately <strong>2–4 weeks</strong>.
              The schedule depends primarily on the accessibility and specialisation
              of the target customer group and is confirmed before the project begins.
            </p>
          </div>
          <div class="price-card">
            <span class="price-label">Fixed project price</span>
            <p class="price">€2,900 + VAT</p>
            <p>
              Includes prospect selection and approval, recruitment, 20 interviews,
              transcripts, analysis, report and recommendation.
            </p>
            <a class="button button-full" href="#contact">Submit your idea</a>
          </div>
        </div>
      </section>

      <section id="about-kari" class="section section-dark">
        <div class="container split-layout">
          <div class="about-intro">
            <p class="eyebrow eyebrow-light">Your independent validation partner</p>
            <h2>The interviews are led by an experienced commercial operator.</h2>
            <img src="/kari-jaaskelainen.jpg" width="1200" height="1200" loading="lazy" alt="Dr. Kari Jääskeläinen" />
          </div>
          <div class="body-copy body-copy-light">
            <p>
              Dr. Kari Jääskeläinen is an entrepreneur, business leader and consultant
              whose work combines market validation, technology commercialization
              and practical business development.
            </p>
            <p>
              He has completed around 200 commercialization and business development
              projects and co-founded ventures in MedTech, private higher education,
              wireless technology and artificial intelligence.
            </p>
            <a class="button button-light" href="/about-kari-jaaskelainen/">Read about Dr. Kari’s experience</a>
          </div>
        </div>
      </section>

      <section id="faq" class="section section-soft">
        <div class="container faq-layout">
          <div>
            <p class="eyebrow">Frequently asked questions</p>
            <h2>Questions before you commission the work.</h2>
          </div>
          <div class="faq-list">
            {faqs.map(({ question, answer }) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="section contact-section">
        <div class="container contact-card contact-form-layout">
          <div class="contact-copy">
            <p class="eyebrow eyebrow-light">Submit your idea</p>
            <h2>Let us ask the customers before you build.</h2>
            <p>
              Tell us what you are planning, who might buy or use it and what
              problem it would solve. Dr. Kari will review your submission personally
              and contact you about whether the service is a suitable fit.
            </p>
          </div>
          <form
            id="idea-form"
            class="idea-form"
            action="https://formspree.io/f/xwlkqzap"
            method="POST"
          >
            <div class="form-field"><label for="name">Your name</label><input id="name" name="name" type="text" autocomplete="name" required /></div>
            <div class="form-field"><label for="email">Your email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
            <div class="form-field full"><label for="idea">What are you planning to build?</label><textarea id="idea" name="idea" rows="3" required></textarea></div>
            <div class="form-field full"><label for="customer">Who would buy or use it?</label><textarea id="customer" name="customer" rows="3" required></textarea></div>
            <div class="form-field full"><label for="pain-point">What problem would it solve?</label><textarea id="pain-point" name="pain_point" rows="3" required></textarea></div>
            <input type="hidden" name="_subject" value="New Test Before You Build idea — services and pricing page" />
            <button class="button button-light form-submit" type="submit">Submit your idea</button>
            <p class="form-status" role="status" aria-live="polite"></p>
            <p class="privacy-note">
              By submitting your idea, you ask us to contact you about it. Do not
              include trade secrets or sensitive personal data in your first message.
              Read our <a href="/privacy/">privacy notice</a>.
            </p>
          </form>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-wrap">
        <span>© 2026 Test Before You Build</span>
        <div class="footer-links"><a href="/">Homepage</a><a href="/how-many-customer-interviews/">Customer interview guide</a><a href="/about-kari-jaaskelainen/">About Dr. Kari</a><a href="/privacy/">Privacy</a><span>Evidence before investment.</span></div>
      </div>
    </footer>

    <script is:inline>
      const ideaForm = document.querySelector('#idea-form');
      ideaForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const form = event.currentTarget;
        const submitButton = form.querySelector('button[type="submit"]');
        const status = form.querySelector('.form-status');
        submitButton.disabled = true;
        submitButton.textContent = 'Sending…';
        status.textContent = '';
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) throw new Error('Submission failed');
          window.location.assign('/thank-you/');
        } catch (error) {
          status.textContent = 'We could not send your idea. Please try again in a moment.';
          submitButton.disabled = false;
          submitButton.textContent = 'Submit your idea';
        }
      });
    </script>
  </body>
</html>

<style>
  :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#0d1930;background:#fff;line-height:1.6;font-synthesis:none;text-rendering:optimizeLegibility}
